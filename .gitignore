.env
.env.*
!.env.example
node_modules/
.next/
dist/
build/
coverage/
__pycache__/
.pytest_cache/
.venv/
venv/
*.pyc
.DS_Store
*.log
# Credentials / keys
*.pem
*.key
service-account*.json
credentials*.json
# Review and triage results are working files; their reports are published
# on the feature Issue instead of being committed.
.agents/reviews/*
!.agents/reviews/.gitkeep
.agents/triage/*
!.agents/triage/.gitkeep
# Continuation notes of a feature in progress, kept by the implementer for a
# session that resumes the work.
.agents/handoffs/*
!.agents/handoffs/.gitkeep
# Steps a feature needs from the human, written by the implementer. They are
# copied into the commit message and the pull request.
.agents/manual-steps/
# The record of the last passed verification of this working tree.
.agents/verification/
# The summary of a feature's changes for its commit message, written by the
# implementer, and the final messages of unattended agent sessions.
.agents/summaries/
.agents/run/
