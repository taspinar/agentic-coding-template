{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "findings",
    "limitations",
    "architecture_impact"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "PASS_WITH_MINOR_FINDINGS",
        "CHANGES_REQUIRED"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "title",
          "evidence",
          "impact",
          "recommendation",
          "previous"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor",
              "suggestion"
            ]
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "previous": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "round",
                  "id",
                  "relation",
                  "reason"
                ],
                "properties": {
                  "round": {
                    "type": "integer"
                  },
                  "id": {
                    "type": "string"
                  },
                  "relation": {
                    "type": "string",
                    "enum": [
                      "unresolved",
                      "worsened"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "string"
    },
    "architecture_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "rationale",
        "checked_against"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "none",
            "minor",
            "major",
            "breaking"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "checked_against": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
