---
// The workflow as one line map (DESIGN.md, "Route map with switches" and
// "Workflow explorer"):
// project planning on the ink line, feature execution on the green line,
// with the switches that redraw it for a part of the workflow, the way of
// running a feature, a risk level, a profile and a situation, and a
// walkthrough that follows the route of the current state. Every station
// opens the step detail panel, whose content is that of "Every step in
// detail" (src/lib/steps.ts); its templates are rendered here, and the script
// makes the stations buttons, so without JavaScript nothing pretends to be one.
//
// The build renders the initial state of src/lib/workflow.ts, which is the
// complete drawing without JavaScript; the script below renders every other
// state from the same function. Every element whose look changes carries
// data-key, every text that changes data-label. The words list is the map's
// text alternative and its form on narrow screens.
import agentsConf from "../../../.agents/agents.conf?raw";
import { switches, initial, describe, classesOf, parseAgents } from "../lib/workflow";
import { details, parts, stations as detailed, tabs } from "../lib/steps";
import { href } from "../lib/links";

// The agents of the roles, as .agents/agents.conf of the repository sets them.
const models = parseAgents(agentsConf);
const view = describe(initial, models);
const c = (key: string) => classesOf(view, key);
const label = (key: string) => view.labels[key];
const panels = Object.keys(detailed).map((key) => ({ key, ...details(key)! }));
const rows = [switches.filter((s) => !("minor" in s)), switches.filter((s) => "minor" in s)];

// Stations: x on their row, the shape, the name and the sub-label (mono when
// it is a value), and an optional second sub-label.
type Station = { key: string; x: number; shape: "ring" | "gate"; name: string; sub?: string; k?: boolean; sub2?: string };
const planningRow: Station[] = [
  { key: "p-idea", x: 50, shape: "ring", name: "Idea", sub: "your description" },
  { key: "p-req", x: 210, shape: "ring", name: "Requirements", sub: "start-planning.sh", k: true, sub2: "p-req.sub2" },
  { key: "p-approve-req", x: 360, shape: "gate", name: "Approve", sub: "the requirements" },
  { key: "p-plan", x: 510, shape: "ring", name: "Plan", sub: "architecture, roadmap" },
  { key: "p-review", x: 670, shape: "ring", name: "Plan review", sub: "review-planning.sh", k: true, sub2: "p-review.sub2" },
  { key: "p-approve", x: 860, shape: "gate", name: "Approve the plan", sub: "finish-planning.sh", k: true },
  { key: "p-merge", x: 1050, shape: "gate", name: "Merge the plan", sub: "planning pull request" },
];
const featureRow: Station[] = [
  { key: "f-issue", x: 50, shape: "ring", name: "Feature Issue", sub: "from the roadmap" },
  { key: "f-implement", x: 210, shape: "ring", name: "Implement", sub: "f-implement.sub", k: true },
  { key: "f-checks", x: 370, shape: "ring", name: "Checks", sub: "verify.sh", k: true },
  { key: "f-review", x: 520, shape: "ring", name: "Review", sub: "f-review.sub", k: true },
  { key: "f-commit", x: 830, shape: "ring", name: "Commit", sub: "f-commit.sub" },
  { key: "f-pr", x: 970, shape: "ring", name: "Pull request", sub: "CI checks" },
  { key: "f-merge", x: 1130, shape: "gate", name: "Merge", sub: "f-merge.sub" },
];
const P = 110; // the planning row
const F = 330; // the feature row
const segments = [
  { key: "s-p-req", d: `M50 ${P} H210`, plan: true },
  { key: "s-p-approve-req", d: `M210 ${P} H360`, plan: true },
  { key: "s-p-plan", d: `M360 ${P} H510`, plan: true },
  { key: "s-p-review", d: `M510 ${P} H670`, plan: true },
  { key: "s-p-approve", d: `M670 ${P} H860`, plan: true },
  { key: "s-p-merge", d: `M860 ${P} H1050`, plan: true },
  // From the merged plan to each feature: create-feature-issue.sh.
  { key: "s-f-issue", d: `M1050 ${P} H1130 V205 H50 V${F}`, plan: true },
  { key: "s-f-implement", d: `M50 ${F} H210` },
  { key: "s-f-checks", d: `M210 ${F} H370` },
  { key: "s-f-out", d: `M370 ${F} H450` },
  { key: "s-f-review", d: `M450 ${F} H520` },
  { key: "s-f-findings", d: `M520 ${F} H690` },
  { key: "s-f-in", d: `M690 ${F} H755` },
  { key: "s-f-commit", d: `M755 ${F} H830` },
  { key: "s-f-pr", d: `M830 ${F} H970` },
  { key: "s-f-merge", d: `M970 ${F} H1130` },
];
const text = (value?: string) => (value && value in view.labels ? view.labels[value] : value);
const labelKey = (value?: string) => (value && value in view.labels ? value : undefined);

// The words list: each station with its sub-label and its conditions.
type Word = { key: string; name: string; sub?: string; k?: boolean; cond?: string; you?: boolean; gate?: boolean };
const planningWords: Word[] = [
  { key: "p-idea", name: "Describe the idea", sub: "docs/PROJECT_DESCRIPTION.md", k: true, cond: "In your own words; no agent changes it." },
  { key: "p-req", name: "Clarify the requirements", sub: "start-planning.sh", k: true, cond: "Project Grill asks about the goals, the users, the scope and the constraints, then drafts docs/PROJECT_REQUIREMENTS.md." },
  { key: "p-approve-req", name: "Approve the requirements", sub: "by you", you: true, cond: "The planning goes on only after your approval." },
  { key: "p-plan", name: "Create the plan", sub: "architecture, roadmap, ADRs", cond: "A fresh planning session writes docs/architecture.md, docs/roadmap.md and the ADRs that are needed." },
  { key: "p-review", name: "Review the plan", sub: "review-planning.sh", k: true, cond: "An independent, read-only reviewer. With findings, revise-planning.sh proposes a decision per finding, you approve them, and the plan is reviewed again, until a round changes nothing." },
  { key: "p-approve", name: "Approve the plan", sub: "finish-planning.sh", k: true, you: true, cond: "Records your approval with a fingerprint of the requirements and the roadmap; a later change to them makes it stale. Refused while the review is stale or a required decision is missing." },
  { key: "p-merge", name: "Merge the planning pull request", sub: "by you", you: true, cond: "The plan is on main. A later change of the plan goes through this line again: start-planning.sh <name> --change <file>." },
];
const featureWords: Word[] = [
  { key: "f-issue", name: "Create a feature Issue", sub: "create-feature-issue.sh", k: true, cond: "One roadmap feature; refused while the approval of the plan is stale." },
  { key: "f-implement", name: "Implement the feature", sub: "f-implement.sub", k: true, cond: "w-f-implement.cond" },
  { key: "f-checks", name: "Run the checks", sub: "verify.sh", k: true, cond: "w-f-checks.cond" },
  { key: "f-review", name: "Review the code", sub: "f-review.sub", k: true, cond: "w-f-review.cond" },
  { key: "f-findings", name: "Decide on the findings", sub: "f-findings.sub", gate: true, cond: "w-f-findings.cond" },
  { key: "f-commit", name: "Commit the feature", sub: "finish-feature.sh", k: true, cond: "w-f-commit.cond" },
  { key: "f-pr", name: "Open the pull request", sub: "publish-feature.sh", k: true, cond: "Pushes the branch and opens the pull request with the verification, the review, the risk level and whether the merge needs your approval; CI runs the checks again. Unfinished work becomes a draft that leaves the Issue open." },
  { key: "f-merge", name: "Merge", sub: "f-merge.sub", you: true, cond: "w-f-merge.cond" },
];
---
<figure class="route workflow" id="workflow" aria-labelledby="workflow-title" data-workflow data-models={JSON.stringify(models)}>
  <div class="route-head">
    <h2 id="workflow-title">The route of your change</h2>
    <div class="scenario">
      <p aria-live="polite">
        <strong data-summary>{view.summary.map((bit, i) => <>{i > 0 && <span class="sep" aria-hidden="true">·</span>}{bit}</>)}</strong>
        <span data-caption="lead"></span> <span data-caption="text">{view.caption}</span>
      </p>
      <button type="button" class="reset" data-action="reset">Reset</button>
    </div>
    <form class="switches grouped" aria-label="Show the workflow for">
      {rows.map((row, i) => (
        <div class:list={["switch-row", { minor: i > 0 }]}>
          {row.map((s) => (
            <fieldset class="switch">
              <legend>{s.legend}</legend>
              {s.options.map(([value, name]) => (
                <label><input type="radio" name={s.name} value={value} checked={initial[s.name] === value} /><span>{name}</span></label>
              ))}
            </fieldset>
          ))}
        </div>
      ))}
    </form>
  </div>

  <svg class="map" viewBox="-30 0 1260 482" role="img" aria-labelledby="workflow-map-title" aria-describedby="workflow-words">
    <title id="workflow-map-title">The workflow as a line map: project planning on one line, from the idea to the merged plan, then each feature on a second line from its Issue to the merge, with the owner's decisions, the loops for a clarification, a failed check and review findings, and the review bypass of low risk under a policy without review for it.</title>
    <text class:list={["stage", c("t-planning")]} data-key="t-planning" x="-20" y="28">Plan the project: once, and for each change of the plan</text>
    <text class:list={["stage", c("t-feature")]} data-key="t-feature" x="80" y="240">Build each feature: in its own branch and worktree</text>

    <!-- loops above the lines -->
    <path class:list={["branch", c("b-revise")]} data-key="b-revise" d={`M662 ${P - 6} L626 ${P - 42} H554 L518 ${P - 6}`} />
    <text class="note" x="590" y={P - 52} text-anchor="middle">findings: revise, you approve, review again</text>
    <path class:list={["branch", c("b-clarify")]} data-key="b-clarify" d={`M204 ${F - 6} L172 ${F - 38}`} />
    <rect class:list={["gate-o", c("f-answer")]} data-key="f-answer" x="157" y={F - 53} width="15" height="15" transform={`rotate(45 164.5 ${F - 45.5})`} />
    <text class="note" x="148" y={F - 68} text-anchor="middle">unclear: you answer</text>
    <path class:list={["branch", c("b-repair")]} data-key="b-repair" d={`M362 ${F - 6} L326 ${F - 42} H254 L218 ${F - 6}`} />
    <text class="note" x="290" y={F - 52} text-anchor="middle">checks fail: repair</text>
    <path class:list={["branch", c("b-fix")]} data-key="b-fix" d={`M682 ${F - 6} L640 ${F - 48} H420 L378 ${F - 6}`} />
    <text class="note" x="530" y={F - 58} text-anchor="middle">findings to fix: fix, checks, review again</text>

    <!-- the lines -->
    {segments.map((s) => <path class:list={["trunk", { plan: s.plan }, c(s.key)]} data-key={s.key} d={s.d} />)}

    <!-- the review bypass: low risk with low: review: none -->
    <path class:list={["branch", c("b-bypass")]} data-key="b-bypass" d={`M450 ${F + 6} V${F + 70} L472 ${F + 92} H733 L755 ${F + 70} V${F + 6}`} />
    <text class:list={["note", c("n-bypass")]} data-key="n-bypass" x="602" y={F + 116} text-anchor="middle">low risk with low: review: none: no review, and the merge needs your approval</text>
    <text class:list={["note", c("n-unattended")]} data-key="n-unattended" x="590" y={F + 140} text-anchor="middle">unattended: run-feature.sh runs from the implementation to the pull request, and never merges</text>

    <!-- stations -->
    {[planningRow.map((s) => ({ ...s, y: P })), featureRow.map((s) => ({ ...s, y: F }))].flat().map((s) => (
      <g class:list={c(s.key)} data-key={s.key}>
        {s.shape === "ring"
          ? <circle class="dot" cx={s.x} cy={s.y} r="10" />
          : <rect class="gate" x={s.x - 10} y={s.y - 10} width="20" height="20" transform={`rotate(45 ${s.x} ${s.y})`} />}
        <text class="st" x={s.x} y={s.y + 37} text-anchor="middle">{s.name}</text>
        {s.sub && <text class:list={["sub", { k: s.k }]} x={s.x} y={s.y + 56} text-anchor="middle" data-label={labelKey(s.sub)}>{text(s.sub)}</text>}
        {s.sub2 && <text class="sub k" x={s.x} y={s.y + 74} text-anchor="middle" data-label={labelKey(s.sub2)}>{text(s.sub2)}</text>}
      </g>
    ))}
    <!-- the findings: an owner gate step by step, a step of the triage agent unattended -->
    <g class:list={c("f-findings")} data-key="f-findings">
      <circle class:list={["dot", c("f-findings-ring")]} data-key="f-findings-ring" cx="690" cy={F} r="10" />
      <rect class:list={["gate", c("f-findings-gate")]} data-key="f-findings-gate" x="680" y={F - 10} width="20" height="20" transform={`rotate(45 690 ${F})`} />
      <text class="st" x="690" y={F + 37} text-anchor="middle">Findings</text>
      <text class="sub" x="690" y={F + 56} text-anchor="middle" data-label="f-findings.sub">{label("f-findings.sub")}</text>
    </g>
    <text class:list={["sub", "flag", c("n-stop")]} data-key="n-stop" x="210" y={F + 74} text-anchor="middle">stops until you answer</text>
    <text class:list={["sub", "flag", c("f-merge-approval")]} data-key="f-merge-approval" x="1130" y={F + 74} text-anchor="middle">approval required</text>
  </svg>

  <ul class="legend" aria-hidden="true">
    <li><svg width="28" height="8"><path d="M2 4 H26" stroke="var(--ink)" stroke-width="6" stroke-linecap="round" /></svg>planning</li>
    <li><svg width="28" height="8"><path d="M2 4 H26" stroke="var(--line)" stroke-width="6" stroke-linecap="round" /></svg>a feature</li>
    <li><svg width="28" height="8"><path d="M2 4 H26" stroke="var(--rule-strong)" stroke-width="3" stroke-dasharray="6 5" /></svg>only when needed</li>
    <li><svg width="28" height="8"><path d="M2 4 H26" stroke="var(--off)" stroke-width="6" stroke-linecap="round" /></svg>not on this route</li>
    <li><svg width="14" height="14"><circle cx="7" cy="7" r="5" fill="none" stroke="var(--ink)" stroke-width="2.5" /></svg>a step that a script or an agent runs</li>
    <li><svg width="14" height="14"><rect x="3" y="3" width="8" height="8" transform="rotate(45 7 7)" fill="var(--ink)" /></svg>you decide</li>
    <li><svg width="14" height="14"><rect x="3" y="3" width="8" height="8" transform="rotate(45 7 7)" fill="none" stroke="var(--ink)" stroke-width="2" /></svg>you answer, only when asked</li>
  </ul>

  <p class="hint">Select a step on the map for what happens, who acts, the command and what can go wrong.</p>
  <section class="step-panel" id="step-panel" aria-labelledby="step-panel-h" hidden>
    <div class="step-panel-head">
      <h3 id="step-panel-h" tabindex="-1"></h3>
      <button type="button" class="panel-close" aria-label="Close the step details">Close</button>
    </div>
    <div class="tabs" role="tablist" aria-label="Step details">
      {tabs.map((tab, i) => (
        <button role="tab" type="button" id={`step-tab-${tab.id}`} data-tab={tab.id} aria-controls="step-tab-body" aria-selected={String(i === 0)} tabindex={i === 0 ? undefined : "-1"}>{tab.name}</button>
      ))}
    </div>
    <div class="tab-body" id="step-tab-body" role="tabpanel" aria-labelledby="step-tab-overview"></div>
  </section>
  {panels.map((panel) => (
    <template data-step={panel.key} data-title={panel.title}>
      {panel.tabs.map((tab) => (
        <div data-tab={tab.id} hidden={tab.id !== "overview"}>
          {tab.id === "overview" && panel.summaries.map((text) => <p>{parts(text).map((v) => (v.code ? <code>{v.part}</code> : v.part))}</p>)}
          {tab.rows.length
            ? (
              <dl class="ref-fields">
                {tab.rows.map((row) => (
                  <>
                    <dt>{row.label}</dt>
                    <dd>{row.facts.map((fact, i) => (
                      <>{i > 0 && <br />}{fact.shown && <><span class="sub">{fact.label}</span> </>}{parts(fact.value).map((v) => (v.code ? <code>{v.part}</code> : v.part))}</>
                    ))}</dd>
                  </>
                ))}
              </dl>
            )
            : tab.id !== "overview" && <p class="ref-empty">Nothing in the reference for this step.</p>}
        </div>
      ))}
      <p class="ref-link">In the reference: {panel.steps.map((step, i) => <>{i > 0 && " · "}<a href={href(`docs/reference/workflow/#${step.id}`)}>{step.title}</a></>)}</p>
    </template>
  ))}

  <div class="map-actions" role="group" aria-label="Walkthrough and list">
    <button type="button" data-action="play">Play walkthrough</button>
    <button type="button" data-action="previous" hidden>Previous step</button>
    <button type="button" data-action="next" hidden>Next step</button>
    <button type="button" data-action="finish" hidden>Show the complete workflow</button>
    <button type="button" class="list-toggle" data-action="list" aria-expanded="false" aria-controls="workflow-words">Show the steps as a list</button>
  </div>

  <div class="words-set" id="workflow-words">
    <div class:list={c("w-planning")} data-key="w-planning">
      <h3>Plan the project</h3>
      <ol class="words">
        {planningWords.map((w) => (
          <li class:list={[{ you: w.you }, c(w.key)]} data-key={w.key}>
            <b>{w.name}</b>{w.sub && <small class:list={{ k: w.k }}>{w.sub}</small>}{w.cond && <p class="cond">{w.cond}</p>}
          </li>
        ))}
      </ol>
    </div>
    <div class:list={c("w-feature")} data-key="w-feature">
      <h3>Build each feature</h3>
      <ol class="words">
        {featureWords.map((w) => (
          <li class:list={[{ you: w.you }, c(w.key), c(`w-${w.key}`)]} data-key={w.key} data-word={`w-${w.key}`} data-gate={w.gate ? "" : undefined}>
            <b>{w.name}</b>
            {w.sub && <small class:list={{ k: w.k }} data-label={labelKey(w.sub)}>{labelKey(w.sub) ? label(w.sub) : w.sub}</small>}
            {w.cond && <p class="cond" data-label={labelKey(w.cond)}>{labelKey(w.cond) ? label(w.cond) : w.cond}</p>}
          </li>
        ))}
      </ol>
    </div>
  </div>
</figure>

<script>
  // Redraws the map for the state of the switches and plays the walkthrough
  // of that state: one step at a time, as a change of stroke colour only,
  // pausing at each of your decisions. With prefers-reduced-motion: reduce,
  // nothing advances by itself; the reader moves with Previous and Next.
  // Every station, and every item of the words list, opens the step detail
  // panel with the content of its template.
  import { describe, initial, stateOf, classesOf, type Models, type View } from "../lib/workflow";

  const figure = document.querySelector<HTMLElement>("[data-workflow]");
  const form = figure?.querySelector<HTMLFormElement>("form");
  if (figure && form) {
    const models = JSON.parse(figure.dataset.models ?? "{}") as Models;
    const keyed = Array.from(figure.querySelectorAll<HTMLElement | SVGElement>("[data-key]"));
    const labelled = Array.from(figure.querySelectorAll<HTMLElement | SVGElement>("[data-label]"));
    const summary = figure.querySelector<HTMLElement>("[data-summary]")!;
    const lead = figure.querySelector<HTMLElement>('[data-caption="lead"]')!;
    const caption = figure.querySelector<HTMLElement>('[data-caption="text"]')!;
    const button = (action: string) => figure.querySelector<HTMLButtonElement>(`[data-action="${action}"]`)!;
    const play = button("play"), previous = button("previous"), next = button("next"), finish = button("finish"), list = button("list");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const pace = 2200;

    let view: View = describe(stateOf({}), models);
    let at = -1; // the step of the walkthrough, -1 for the complete drawing
    let playing = false;
    let timer = 0;

    const values = () => Object.fromEntries(Array.from(new FormData(form).entries(), ([name, value]) => [name, String(value)]));

    function render() {
      const lit = at < 0 ? undefined : new Set(view.walk.slice(0, at + 1).flatMap((step) => step.lights));
      const current = at < 0 ? undefined : view.walk[at];
      for (const element of keyed) {
        const key = element.dataset.key!;
        const word = element.dataset.word;
        const classes = classesOf(view, key, lit);
        if (word && view.hidden.includes(word)) classes["is-hidden"] = true;
        for (const [name, on] of Object.entries(classes)) {
          if (name !== "you" || element.hasAttribute("data-gate")) element.classList.toggle(name, on);
        }
        if (element.tagName === "LI") {
          if (current?.key === key) element.setAttribute("aria-current", "step");
          else element.removeAttribute("aria-current");
        }
      }
      for (const element of labelled) element.textContent = view.labels[element.dataset.label!] ?? element.textContent;
      summary.replaceChildren(...view.summary.flatMap((bit, i) => {
        if (i === 0) return [bit];
        const dot = document.createElement("span");
        dot.className = "sep";
        dot.setAttribute("aria-hidden", "true");
        dot.textContent = "·";
        return [dot, bit];
      }));
      lead.textContent = current ? `Step ${at + 1} of ${view.walk.length}.` : "";
      caption.textContent = current ? current.text : view.caption;
      const walking = at >= 0;
      figure.classList.toggle("walking", walking);
      const last = at === view.walk.length - 1;
      play.hidden = reduced.matches && walking;
      play.textContent = playing ? "Pause" : !walking ? (reduced.matches ? "Walk through the steps" : "Play walkthrough") : last ? "Play again" : "Resume";
      previous.hidden = next.hidden = finish.hidden = !walking;
      previous.setAttribute("aria-disabled", String(at <= 0));
      next.setAttribute("aria-disabled", String(last));
    }

    function stop() {
      playing = false;
      window.clearTimeout(timer);
    }
    function advance() {
      window.clearTimeout(timer);
      if (!playing) return;
      timer = window.setTimeout(() => {
        if (at < view.walk.length - 1) {
          at += 1;
          // The walkthrough waits at the end and at each of your decisions.
          if (at === view.walk.length - 1 || view.walk[at].you) playing = false;
          render();
          advance();
        }
      }, pace);
    }

    form.addEventListener("change", () => {
      stop();
      at = -1;
      view = describe(stateOf(values()), models);
      render();
    });
    button("reset").addEventListener("click", () => {
      for (const [name, value] of Object.entries(initial)) {
        const radio = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`);
        if (radio) radio.checked = true;
      }
      form.dispatchEvent(new Event("change"));
    });
    play.addEventListener("click", () => {
      if (playing) {
        stop();
      } else {
        if (at < 0 || at === view.walk.length - 1) at = 0;
        playing = !reduced.matches;
        advance();
      }
      render();
      if (play.hidden) next.focus();
    });
    previous.addEventListener("click", () => {
      if (at <= 0) return;
      stop();
      at = Math.max(0, at - 1);
      render();
    });
    next.addEventListener("click", () => {
      if (at >= view.walk.length - 1) return;
      stop();
      at = Math.min(view.walk.length - 1, at + 1);
      render();
    });
    finish.addEventListener("click", () => {
      stop();
      at = -1;
      render();
      play.focus();
    });
    reduced.addEventListener("change", () => {
      if (reduced.matches) stop();
      render();
    });

    // The step detail panel: under the map, or inside the item of the words
    // list that opened it. Tabs move with the arrow keys (roving tabindex).
    const panel = figure.querySelector<HTMLElement>("#step-panel")!;
    const home = document.createComment("step panel");
    panel.before(home);
    const heading = panel.querySelector<HTMLElement>("h3")!;
    const body = panel.querySelector<HTMLElement>("[role=tabpanel]")!;
    const tabs = Array.from(panel.querySelectorAll<HTMLButtonElement>("[role=tab]"));
    const template = (key: string) => figure.querySelector<HTMLTemplateElement>(`template[data-step="${key}"]`);
    let opener: HTMLElement | SVGElement | undefined;

    function select(name: string) {
      for (const tab of tabs) {
        const on = tab.dataset.tab === name;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on) body.setAttribute("aria-labelledby", tab.id);
      }
      for (const part of body.querySelectorAll<HTMLElement>("[data-tab]")) part.hidden = part.dataset.tab !== name;
    }
    function open(key: string, from: HTMLElement | SVGElement, item?: HTMLElement) {
      const content = template(key)!;
      body.replaceChildren(content.content.cloneNode(true));
      heading.textContent = content.dataset.title!;
      for (const element of figure!.querySelectorAll(".is-selected")) element.classList.remove("is-selected");
      for (const element of figure!.querySelectorAll(`svg g[data-key="${key}"]`)) element.classList.add("is-selected");
      if (item) item.append(panel);
      else home.after(panel);
      panel.hidden = false;
      opener = from;
      select("overview");
      heading.focus();
    }
    function close() {
      panel.hidden = true;
      home.after(panel);
      for (const element of figure!.querySelectorAll(".is-selected")) element.classList.remove("is-selected");
      opener?.focus();
    }

    // With focusable stations inside, the drawing is a group, no longer an image.
    figure.querySelector("svg.map")!.setAttribute("role", "group");
    for (const station of figure.querySelectorAll<SVGGElement>("svg g[data-key]")) {
      const key = station.dataset.key!;
      const content = template(key);
      if (!content) continue;
      station.classList.add("station");
      station.setAttribute("tabindex", "0");
      station.setAttribute("role", "button");
      station.setAttribute("aria-label", `Details: ${content.dataset.title}`);
      station.addEventListener("click", () => open(key, station));
      station.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        open(key, station);
      });
    }
    for (const item of figure.querySelectorAll<HTMLElement>(".words li[data-key]")) {
      const key = item.dataset.key!;
      const content = template(key);
      if (!content) continue;
      const details = document.createElement("button");
      details.type = "button";
      details.className = "detail-btn";
      details.textContent = "Details";
      details.setAttribute("aria-label", `Details: ${content.dataset.title}`);
      details.addEventListener("click", () => open(key, details, item));
      item.querySelector("b")!.after(details);
    }
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab.dataset.tab!));
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        const to = tabs[(i + step + tabs.length) % tabs.length];
        select(to.dataset.tab!);
        to.focus();
      });
    });
    panel.querySelector(".panel-close")!.addEventListener("click", close);
    list.addEventListener("click", () => {
      const shown = list.getAttribute("aria-expanded") !== "true";
      list.setAttribute("aria-expanded", String(shown));
      list.textContent = shown ? "Hide the list" : "Show the steps as a list";
      figure.dataset.list = shown ? "shown" : "";
      // A panel inside the list that is hidden again goes back under the map.
      if (!shown && panel.closest(".words")) home.after(panel);
    });

    // A reload can restore the switches the reader had chosen.
    view = describe(stateOf(values()), models);
    render();
  }
</script>
