---
// The head of an inner page: its title and one lede paragraph. A tight head
// leaves the space below to the figure that follows it.
interface Props { title: string; lede?: string; tight?: boolean }
const { title, lede, tight } = Astro.props;
---
<div class:list={["page-head", "wrap", { tight }]}>
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</div>
