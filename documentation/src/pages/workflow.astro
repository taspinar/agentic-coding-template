---
// The workflow: the explorer (the line map with its states, walkthrough and
// step detail), the two ways of running a feature, and every step with who
// runs it, the script, the result and when it stops (src/lib/steps.ts, the
// content of the step detail too). The facts are those of docs/development.md.
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Section from "../components/Section.astro";
import WorkflowMap from "../components/WorkflowMap.astro";
import { repoFile } from "../lib/links";
import { planning, feature, parts as values } from "../lib/steps";

const guide = repoFile("docs/development.md");
---
<Base title="Workflow" description="How the ACT workflow runs: a project is planned once, then each feature goes from its Issue to the merge, step by step or unattended, by risk level and profile.">
  <PageHead tight title="From idea to reviewed pull request." lede="A project is planned once. Each feature then moves through its own implementation, verification, review and approval path. Agents do the work, checks provide the evidence, and you keep the decisions and the merge." />

  <div class="wrap">
    <WorkflowMap />
  </div>

  <Section id="ways" title="Step by step or unattended">
    <Fragment slot="note">From <a href={`${guide}#running-a-feature-with-one-command`}><code>docs/development.md</code></a>.</Fragment>
    <p>The steps are the same. What differs is who decides about the review findings, and where the run can stop. Neither way merges: the merge is always yours.</p>
    <div class="compare">
      <div class="col">
        <h3>Step by step</h3>
        <dl>
          <dt>Review findings</dt><dd>You approve the proposed decisions.</dd>
          <dt>Stepping in</dt><dd>Between any two steps.</dd>
          <dt>A question</dt><dd>The session ends with its questions in the handoff note.</dd>
          <dt>Result</dt><dd>You move through the steps yourself.</dd>
        </dl>
      </div>
      <div class="col">
        <h3>Unattended <code>run-feature.sh</code></h3>
        <dl>
          <dt>Review findings</dt><dd>The triage agent decides and records; you read the decisions afterwards.</dd>
          <dt>Stepping in</dt><dd>It retries a temporary failure, has the implementer repair a failing check, and stops when it cannot safely go on.</dd>
          <dt>A question</dt><dd>The run stops with status 3 and names the handoff note.</dd>
          <dt>Result</dt><dd>An open pull request, or why the run stopped. Never a merge.</dd>
        </dl>
      </div>
    </div>
    <p>Every command, input, output, gate and stop condition, step by step, is in the workflow reference: <a href="#steps">Every step in detail</a>.</p>
  </Section>

  <Section id="steps" title="Every step in detail">
    <Fragment slot="note">Every command and option in <a href={guide}><code>docs/development.md</code></a>.</Fragment>
    <h3 class="stage-title">Plan the project</h3>
    <p class="stage-note">Once at the start, and again when the plan changes.</p>
    {planning.map((step) => (
      <article class="step" id={step.id} aria-labelledby={`${step.id}-h`}>
        <h4 id={`${step.id}-h`}>{step.title}</h4>
        <p>{values(step.text).map((v) => (v.code ? <code>{v.part}</code> : v.part))}</p>
        <dl class="facts">{step.facts.map(([term, value]) => <><dt>{term}</dt><dd>{values(value).map((v) => (v.code ? <code>{v.part}</code> : v.part))}</dd></>)}</dl>
      </article>
    ))}
    <h3 class="stage-title">Build each feature</h3>
    <p class="stage-note">For every roadmap feature, in its own branch and worktree.</p>
    {feature.map((step) => (
      <article class="step" id={step.id} aria-labelledby={`${step.id}-h`}>
        <h4 id={`${step.id}-h`}>{step.title}</h4>
        <p>{values(step.text).map((v) => (v.code ? <code>{v.part}</code> : v.part))}</p>
        <dl class="facts">{step.facts.map(([term, value]) => <><dt>{term}</dt><dd>{values(value).map((v) => (v.code ? <code>{v.part}</code> : v.part))}</dd></>)}</dl>
      </article>
    ))}
  </Section>
</Base>
