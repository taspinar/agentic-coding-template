          <label><input type="radio" name="risk" value="high"><span>high</span></label>
        </fieldset>
        <fieldset class="switch">
          <legend>profile</legend>
          <label><input type="radio" name="profile" value="standard" checked><span>standard</span></label>
          <label><input type="radio" name="profile" value="light"><span>light</span></label>
