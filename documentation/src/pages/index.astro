---
// The home page, built from the approved design (design/prototype/index.html,
// design/DESIGN.md). The facts follow the audit of #235; every example links
// to its Issue and pull request. The risk and profile switches of the route
// map are the one island; without script the map shows medium risk under the
// standard profile, and the words list carries the same route as text.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import DiagramFrame from "../components/DiagramFrame.astro";
import Table from "../components/Table.astro";
import { site } from "../../site.config";
import { href, issue, pull, repoFile } from "../lib/links";

const [first, second] = site.tagline.split(/(?<=\.) /);
const repositoryName = site.repository.replace(/^https?:\/\//, "");
const templateName = site.repository.replace(/^https:\/\/github\.com\//, "");

// Recent features of this repository: run records and the published reviews.
const runs = [
  { issue: 217, change: "Give every later review round the earlier decisions", implementer: "claude opus", rounds: "5: two majors fixed, one minor accepted", verify: 1046, pull: 222 },
  { issue: 193, change: "Treat performance budgets as measurements", implementer: "claude fable", rounds: "4: a major re-raised as unresolved, then fixed", verify: 761, pull: 199 },
  { issue: 189, change: "Compute the risk level from one policy", implementer: "claude fable", rounds: "3, after a defect the owner found", verify: 572, pull: 194 },
  { issue: 16, change: "Stop for questions before implementing", implementer: "claude opus", rounds: "1, no findings", verify: 849, pull: 213 },
  { issue: 157, change: "Detect workflow complexity creep", implementer: "claude fable", rounds: "13 over two attempts, a finding open at the end of each" },
];

// The proposals of the run analysis of 28 October 2026 that became Issues.
const proposals = [
  { issue: 216, change: "Record the step and the reason of every stop", pull: 223 },
  { issue: 217, change: "Give every later review round the earlier decisions", pull: 222 },
  { issue: 218, change: "Stop a false partial completion in the handoff note", pull: 221 },
  { issue: 219, change: "Time every check and budget the self-test suite", pull: 224 },
  { issue: 220, change: "Warn about calls of models that agents.conf does not declare", pull: 225 },
];
---
<Base description={site.description}>
  <div class="hero wrap" data-risk="medium" data-profile="standard" id="lifecycle">
    <div class="hero-grid">
      <h1>{first} <em>{second}</em></h1>
      <div class="hero-side">
        <p class="lede">{site.description}</p>
        <div class="actions">
          <a class="btn" href={href("docs/")}>Get started</a>
          <a href={site.repository}>Source on GitHub</a>
          <a href={href("workflow/")}>How the workflow runs</a>
        </div>
      </div>
    </div>

    <DiagramFrame id="route" title="The route of one feature">
      <form slot="controls" class="switches" aria-label="Show the route for">
        <fieldset class="switch">
          <legend>risk</legend>
