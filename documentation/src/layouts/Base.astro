---
// The page frame: head with the SEO metadata, header with the navigation,
// the page, footer. Every page of the site uses it.
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../../site.config";
import { href } from "../lib/links";
import headingFont from "../fonts/overpass-latin-800-normal.woff2?url";

interface Props {
  /** The page title; the home page passes none and gets the product line. */
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title
  ? `${title} · ${site.shortName}`
  : `${site.name} (${site.shortName}): ${site.tagline.replace(/\.$/, "").replace(". ", ", ").toLowerCase()}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:site_name" content={`${site.name} (${site.shortName})`}>
<meta property="og:title" content={title ?? site.tagline}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:locale" content="en">
<link rel="sitemap" href={href("sitemap.xml")}>
<link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin>
<script is:inline>document.documentElement.classList.add("js");try{var t=localStorage.getItem("act-theme");if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<Header />
<main id="main" tabindex="-1">
  <slot />
</main>
<Footer />
</body>
</html>
